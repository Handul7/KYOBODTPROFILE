# 복사해서 사용: cp .env.example .env
# .env는 .gitignore에 등록되어 있어 커밋되지 않습니다. API 키를 절대 커밋하지 마세요.

# gemini: Gemini 재생성 + 로컬 규격 보정 / local: 로컬 처리 / openai: 이미지 편집 / mock: 화면 검증
AI_PROVIDER=local

# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# OpenAI 모드를 쓸 때만 필요
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_VISION_MODEL=gpt-6-luna
OPENAI_IMAGE_QUALITY=high

# 로컬 AI 서버 (npm run local-ai)
LOCAL_AI_ENDPOINT=http://127.0.0.1:8765/transform
LOCAL_AI_VALIDATE_ENDPOINT=http://127.0.0.1:8765/validate

# 로컬 개발용 기본값입니다. 공개 배포 시 반드시 길고 고유한 비밀번호로 변경하세요.
APP_PASSWORD=kyobo
# 공개 HTTPS 배포 시 production으로 설정하세요.
NODE_ENV=development
# 외부 AI 요청별 제한 시간 (밀리초)
AI_TIMEOUT_MS=120000
HOST=0.0.0.0
PORT=5173

# 사용자 지정 로컬 서버의 상태 경로가 다를 때만 설정
# LOCAL_AI_HEALTH_ENDPOINT=http://127.0.0.1:8765/health
# Python 서버 기본 모델: u2net_human_seg (정밀), u2netp (가벼운 테스트용)
# REMBG_MODEL=u2net_human_seg
