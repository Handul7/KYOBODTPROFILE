# 복사해서 사용: cp .env.example .env
# .env는 .gitignore에 등록되어 있어 커밋되지 않습니다. API 키를 절대 커밋하지 마세요.

# gemini(추천): Gemini 재생성 + 로컬 규격 보정 / local: 완전 오프라인 / openai: gpt-image
AI_PROVIDER=gemini

# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# OpenAI 모드를 쓸 때만 필요
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_IMAGE_QUALITY=high

# 로컬 AI 서버 (npm run local-ai)
LOCAL_AI_ENDPOINT=http://127.0.0.1:8765/transform
LOCAL_AI_VALIDATE_ENDPOINT=http://127.0.0.1:8765/validate

APP_PASSWORD=kyobo
HOST=0.0.0.0
PORT=5173
